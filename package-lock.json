<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Oẳn Tù Tì Cắt Dây - Chibi Edition</title>
  <script src="/socket.io/socket.io.js"></script>
  <!-- SDK Đăng Nhập Google -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Bungee&family=Nunito:wght@700;900&display=swap');

    :root {
      --bg-main: #0f111a;
      --card-bg: #1c1e2e;
      --accent-yellow: #ffcc00;
      --accent-red: #ff3366;
      --accent-blue: #00d2ff;
      --accent-green: #00e676;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Nunito', sans-serif; }

    body {
      background: radial-gradient(circle at center, #1b1e31 0%, #08090e 100%);
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 15px;
    }

    .game-card {
      width: 100%;
      max-width: 460px;
      background: var(--card-bg);
      border: 4px solid #2d324d;
      border-radius: 28px;
      padding: 24px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 20px rgba(0, 210, 255, 0.1);
      text-align: center;
      position: relative;
    }

    h1 {
      font-family: 'Bungee', cursive;
      color: var(--accent-yellow);
      font-size: 26px;
      text-shadow: 3px 3px 0px #000, 0 0 10px rgba(255, 204, 0, 0.4);
      margin-bottom: 15px;
      letter-spacing: 1px;
    }

    /* KHU VỰC ĐĂNG NHẬP GOOGLE */
    .auth-box {
      background: rgba(255,255,255,0.05);
      border: 2px dashed #3d446b;
      border-radius: 20px;
      padding: 15px;
      margin-bottom: 15px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .user-profile {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      background: #25293d;
      padding: 10px 16px;
      border-radius: 50px;
      border: 2px solid var(--accent-blue);
    }

    .user-profile img {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 2px solid var(--accent-yellow);
    }

    .user-profile span {
      font-weight: 900;
      color: #fff;
      font-size: 15px;
    }

    /* SÂN ĐẤU NHÂN VẬT CHIBI */
    .arena {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 20px 0;
      background: #121420;
      padding: 15px;
      border-radius: 20px;
      border: 2px solid #282c44;
    }

    .chibi-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 42%;
    }

    .avatar-wrapper {
      position: relative;
      width: 95px;
      height: 95px;
    }

    .chibi-img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 4px solid var(--accent-yellow);
      background: #2a2e45;
      object-fit: cover;
      box-shadow: 0 8px 16px rgba(0,0,0,0.4);
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .chibi-img.shake {
      animation: shake 0.4s infinite;
    }

    @keyframes shake {
      0% { transform: translate(2px, 2px) rotate(0deg); }
      20% { transform: translate(-3px, 0px) rotate(6deg); }
      40% { transform: translate(2px, -2px) rotate(-6deg); }
      60% { transform: translate(-3px, 2px) rotate(0deg); }
      80% { transform: translate(2px, 2px) rotate(6deg); }
      100% { transform: translate(1px, -2px) rotate(-6deg); }
    }

    .player-tag {
      margin-top: 8px;
      font-weight: 900;
      font-size: 13px;
      color: var(--accent-blue);
      max-width: 100px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .vs-text {
      font-family: 'Bungee', cursive;
      font-size: 22px;
      color: var(--accent-red);
      text-shadow: 2px 2px 0 #000;
    }

    /* DÀN DÂY CẮT GAY CẤN */
    .wire-group {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin: 20px 0;
    }

    .btn-wire {
      flex: 1;
      height: 110px;
      border: none;
      border-radius: 16px;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      padding: 12px 6px;
      font-weight: 900;
      color: #fff;
      box-shadow: 0 6px 0 rgba(0,0,0,0.5);
      transition: transform 0.1s, box-shadow 0.1s;
    }

    .btn-wire:active {
      transform: translateY(4px);
      box-shadow: 0 2px 0 rgba(0,0,0,0.5);
    }

    .wire-1 { background: linear-gradient(180deg, #ff4757, #c0392b); }
    .wire-2 { background: linear-gradient(180deg, #2ed573, #27ae60); }
    .wire-3 { background: linear-gradient(180deg, #1e90ff, #2980b9); }

    .btn-main {
      font-family: 'Bungee', cursive;
      width: 100%;
      background: var(--accent-yellow);
      color: #000;
      padding: 14px;
      border: none;
      border-radius: 50px;
      font-size: 16px;
      cursor: pointer;
      box-shadow: 0 6px 0 #c7a000;
      transition: all 0.1s;
    }

    .btn-main:active {
      transform: translateY(3px);
      box-shadow: 0 3px 0 #c7a000;
    }

    .status-info {
      min-height: 28px;
      font-weight: 900;
      font-size: 15px;
      color: #d1d8e0;
      margin: 12px 0;
    }
  </style>
</head>
<body>

  <div class="game-card">
    <h1>✂️ OẮN TÙ TÌ CẮT DÂY 💣</h1>

    <!-- GOOGLE LOGIN -->
    <div class="auth-box" id="authBox">
      <p style="font-weight:700; font-size:14px; margin-bottom:10px; color:#aaa;">Đăng nhập Google để chơi:</p>
      <div id="g_id_onload"
        data-client_id="624410093822-dmhrvoeg1pk0lr474vp4pu1qbet332d9.apps.googleusercontent.com"
        data-callback="handleCredentialResponse">
      </div>
      <div class="g_id_signin" data-type="standard" data-shape="pill" data-theme="filled_blue"></div>
    </div>

    <!-- PROFILE KHI ĐÃ ĐĂNG NHẬP -->
    <div id="userProfileBox" style="display:none; margin-bottom: 15px;">
      <div class="user-profile">
        <img id="googleAvatar" src="" alt="Google Avatar">
        <span id="googleName">Player</span>
      </div>
    </div>

    <!-- SÂN ĐẤU CHIBI -->
    <div class="arena">
      <div class="chibi-box">
        <div class="avatar-wrapper">
          <img id="p1Avatar" class="chibi-img" src="https://api.dicebear.com/7.x/bottts/svg?seed=Player1&backgroundColor=b6e3f4" alt="Chibi P1">
        </div>
        <div id="p1Name" class="player-tag">Bạn</div>
      </div>

      <div class="vs-text">VS</div>

      <div class="chibi-box">
        <div class="avatar-wrapper">
          <img id="p2Avatar" class="chibi-img" src="https://api.dicebear.com/7.x/adventurer/svg?seed=Opponent&backgroundColor=ffdfbf" alt="Chibi P2">
        </div>
        <div id="p2Name" class="player-tag">Khách Mới</div>
      </div>
    </div>

    <div id="statusText" class="status-info">Sẵn sàng! Bấm nút bên dưới để tìm trận.</div>

    <!-- NÚT CẮT DÂY -->
    <div class="wire-group">
      <button class="btn-wire wire-1" onclick="cutWire(1)">
        <span>🔴</span>
        <span style="font-size: 22px;">✂️</span>
        <span>DÂY 1</span>
      </button>
      <button class="btn-wire wire-2" onclick="cutWire(2)">
        <span>🟢</span>
        <span style="font-size: 22px;">✂️</span>
        <span>DÂY 2</span>
      </button>
      <button class="btn-wire wire-3" onclick="cutWire(3)">
        <span>🔵</span>
        <span style="font-size: 22px;">✂️</span>
        <span>DÂY 3</span>
      </button>
    </div>

    <button class="btn-main" onclick="findOpponent()">🎮 TÌM ĐỐI THỦ NHANH</button>
  </div>

  <script>
    // --- BỘ ÂM THANH (WEB AUDIO SYNTHESIZER) ---
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playSound(type) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);

      if (type === 'cut') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(900, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(120, audioCtx.currentTime + 0.12);
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.12);
        osc.start(); osc.stop(audioCtx.currentTime + 0.12);
      } else if (type === 'boom') {
        osc.type = 'square';
        osc.frequency.setValueAtTime(160, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(30, audioCtx.currentTime + 0.7);
        gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.7);
        osc.start(); osc.stop(audioCtx.currentTime + 0.7);
      } else if (type === 'win') {
        [523, 659, 783, 1046].forEach((f, i) => {
          setTimeout(() => {
            const o = audioCtx.createOscillator();
            const g = audioCtx.createGain();
            o.connect(g); g.connect(audioCtx.destination);
            o.frequency.value = f;
            g.gain.setValueAtTime(0.2, audioCtx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
            o.start(); o.stop(audioCtx.currentTime + 0.2);
          }, i * 90);
        });
      }
    }

    // --- GOOGLE SIGN-IN ---
    function parseJwt(token) {
      const base64Url = token.split('.')[1];
      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
      return JSON.parse(window.atob(base64));
    }

    function handleCredentialResponse(response) {
      const userObj = parseJwt(response.credential);
      
      document.getElementById('authBox').style.display = 'none';
      document.getElementById('userProfileBox').style.display = 'block';
      document.getElementById('googleName').innerText = userObj.name;
      document.getElementById('googleAvatar').src = userObj.picture;

      document.getElementById('p1Name').innerText = userObj.given_name || userObj.name;
      document.getElementById('p1Avatar').src = `https://api.dicebear.com/7.x/bottts/svg?seed=${userObj.email}&backgroundColor=b6e3f4`;
      
      playSound('win');
    }

    // --- LOGIC TRÒ CHƠI ---
    function findOpponent() {
      playSound('cut');
      const randomSeed = Math.floor(Math.random() * 9999);
      document.getElementById('p2Avatar').src = `https://api.dicebear.com/7.x/adventurer/svg?seed=${randomSeed}&backgroundColor=ffdfbf`;
      document.getElementById('p2Name').innerText = "Khách #" + Math.floor(Math.random() * 89 + 10);
      document.getElementById('statusText').innerText = "Đã tìm thấy Khách! Chọn 1 sợi dây để cắt!";
    }

    function cutWire(index) {
      playSound('cut');
      const p1Avatar = document.getElementById('p1Avatar');
      p1Avatar.classList.add('shake');
      document.getElementById('statusText').innerText = `Đang cắt DÂY ${index}... Hồi hộp quá!`;

      setTimeout(() => {
        p1Avatar.classList.remove('shake');
        const isExploded = Math.random() < 0.35;

        if (isExploded) {
          playSound('boom');
          document.getElementById('statusText').innerText = `💥 BÙM! DÂY ${index} NỔ TUNG! Bạn đã thua!`;
          p1Avatar.src = "https://api.dicebear.com/7.x/bottts/svg?seed=Explode&backgroundColor=ff4757";
        } else {
          playSound('win');
          document.getElementById('statusText').innerText = `🎉 THÀNH CÔNG! Dây ${index} an toàn!`;
        }
      }, 1000);
    }
  </script>
</body>
</html>
